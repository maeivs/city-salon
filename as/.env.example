# Entity App Server
NODE_ENV=development

# 서버 포트 (configs/server.json의 port보다 우선)
# SERVER_PORT=58200

# 서버 네임스페이스 (configs/server.json의 namespace보다 우선)
# SERVER_NAMESPACE=entity-app-server

# 패킷 암호화 활성화 여부 (true/false)
# PACKET_ENCRYPT_ENABLED=true

# Entity Server 연결
ENTITY_SERVER_URL=http://127.0.0.1:47200
ENTITY_API_KEY=your-api-key
ENTITY_HMAC_SECRET=change-this-to-32-char-or-longer-hmac-secret

# JWT (Entity Server와 동일한 secret)
JWT_SECRET=change-this-to-same-32-char-or-longer-jwt-secret

# dev 디버그 바이패스용 시크릿 — X-Debug-Plain 헤더가 이 값과 일치하면 패킷암호화 우회(평문). 비우면 기능 비활성.
# DEBUG_PLAIN_SECRET=

# 웹 푸시 알림 설정 (VAPID 키)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# DB 직접 접속 (database.json에서 환경변수 치환용)
# AS에서 DB에 직접 접속할 필요가 있을 때 사용 (예: 마이그레이션, 데이터 초기화 등)
# --- development 그룹 ---
# DB_HOST_DEVELOPMENT=127.0.0.1
# DB_PORT_DEVELOPMENT=3306
# DB_NAME_DEVELOPMENT=mydb_dev
# DB_USER_DEVELOPMENT=root
# DB_PASSWORD_DEVELOPMENT=password

# # --- production 그룹 ---
# DB_HOST_PRODUCTION=db.yourdomain.com
# DB_PORT_PRODUCTION=3306
# DB_NAME_PRODUCTION=mydb
# DB_USER_PRODUCTION=mydb_user
# DB_PASSWORD_PRODUCTION=your-production-password

# # --- production_read 그룹 (읽기 전용 리플리카) ---
# DB_HOST_PRODUCTION_READ=db-read.yourdomain.com
# DB_PORT_PRODUCTION_READ=3306
# DB_NAME_PRODUCTION_READ=mydb
# DB_USER_PRODUCTION_READ=mydb_reader
# DB_PASSWORD_PRODUCTION_READ=your-read-password

# database.json 의 default 그룹을 .env 에서 덮어쓰기
# DB_GROUP=development

# data.go.kr API 키 (디코딩 서비스키 사용)
# DATAGOKR_API_KEY=

# 바로빌
# BAROBILL_USER_ID=
# BAROBILL_PASSWORD=
# BAROBILL_CORP_NUM=
# BAROBILL_CERT_KEY=

# LLM API Keys
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# 알림톡 API Keys
# ALIMTALK_API_KEY=
# ALIMTALK_USER_ID=

# PG Keys
# TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=
# KCP_SITE_CD=
# KCP_SITE_NAME=
# KCP_CERT_INFO=
# KCP_PRIVATE_KEY=
# KAKAO_PAY_CID=
# KAKAO_PAY_ADMIN_KEY=
# NICE_CLIENT_KEY=
# NICE_SECRET_KEY=
# INICIS_MID=
# INICIS_SIGN_KEY=
# INICIS_IV=
# NAVER_PAY_PARTNER_ID=
# NAVER_PAY_CLIENT_ID=
# NAVER_PAY_CLIENT_SECRET=
# NAVER_PAY_CHAIN_ID=
# PAYCO_PARTNER_ID=
# PAYCO_PARTNER_SECRET=
# PAYLETTER_CLIENT_ID=
# PAYLETTER_API_KEY=
# PAYLETTER_API_KEY_SEARCH=
