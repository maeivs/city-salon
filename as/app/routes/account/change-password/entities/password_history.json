{
    "name": "password_history",
    "description": "비밀번호 변경 이력 (재사용 금지 정책용). change-password 라우트에서 관리합니다.",
    "hard_delete": true,
    "index_updated_time": false,
    "fields": {
        "account_seq": {
            "index": true,
            "comment": "계정 seq",
            "required": true
        },
        "passwd_hash": {
            "comment": "변경 시점의 비밀번호 해시 (salt 포함)"
        },
        "changed_time": {
            "comment": "비밀번호 변경 시각"
        }
    }
}
