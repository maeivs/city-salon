{
    "name": "pg_webhook_log",
    "description": "PG 웹훅 수신 이력. 모든 수신 이벤트를 기록합니다.",
    "hard_delete": true,
    "read_only": true,
    "compress": true,
    "index_updated_time": false,
    "fields": {
        "event_type": {
            "index": true,
            "type": "string",
            "required": true,
            "comment": "웹훅 이벤트 타입 (payment.done, payment.canceled 등)"
        },
        "order_id": {
            "index": true,
            "type": "string",
            "comment": "관련 주문번호"
        },
        "payment_key": {
            "index": true,
            "type": "string",
            "comment": "관련 결제 키"
        },
        "status": {
            "index": true,
            "type": ["received", "processed", "failed"],
            "default": "received",
            "comment": "웹훅 처리 상태"
        },
        "provider": {
            "index": true,
            "type": "string",
            "comment": "PG 프로바이더 키"
        },
        "payload": {
            "comment": "수신한 웹훅 원본 JSON"
        },
        "processed_time": {
            "comment": "처리 완료 시각"
        },
        "error_message": {
            "comment": "처리 실패 시 에러 메시지"
        },
        "signature": {
            "comment": "웹훅 서명값 (검증용)"
        }
    }
}
