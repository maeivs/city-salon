{
    "enabled": false,
    "default": "aligo",
    "sender": "${SMS_SENDER_NUMBER}",
    "workers": 2,
    "queue_size": 200,
    "dispatch_interval_sec": 5,
    "max_retries": 3,
    "auto_lms": true,
    "lms_threshold_bytes": 80,
    "providers": {
        "aligo": {
            "driver": "aligo",
            "api_key": "${ALIGO_API_KEY}",
            "user_id": "${ALIGO_USER_ID}",
            "sender": "${SMS_SENDER_NUMBER}"
        }
    },
    "rate_limit": {
        "per_number_per_minute": 5,
        "per_minute": 60,
        "per_hour": 500
    },
    "verification": {
        "code_length": 6,
        "ttl_sec": 180,
        "max_attempts": 5,
        "cooldown_sec": 60
    }
}
