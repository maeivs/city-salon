# .env 로 복사해서 사용 (.env 는 커밋되지 않는다)

# Vite 개발 서버 포트 (codeshop dev(5173)와 겹치지 않게 분리)
SERVER_PORT=5174

# npm run dev 시 접속할 호스트. 같은 localhost 의 다른 환경(codeshop 등)과 쿠키가 섞여
# 서로 로그아웃되는 것을 막기 위해 환경마다 다른 호스트로 분리한다.
# *.localhost 는 hosts 등록 없이 자동으로 127.0.0.1 로 해석된다. (비우면 자동 오픈 안 함)
DEV_HOST=city-salon.localhost

# AS 전체 URL 오버라이드 (기본값: configs/backend/settings.ts 참고)
# city-salon AS 포트는 as/configs/server.json 의 48200 (47200 은 codeshop AS 이므로 사용 금지)
ENTITY_APP_SERVER_URL=http://127.0.0.1:48200
